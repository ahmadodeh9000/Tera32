CC      ?= cc
TARGET  := tera32
SRC_DIR := src

# make               -> debug build
# make MODE=release  -> optimized build
# make MODE=asan     -> AddressSanitizer + UBSan build
MODE ?= debug

ifeq ($(MODE),debug)
  OPT := -O0 -g3
else ifeq ($(MODE),release)
  OPT := -O2 -DNDEBUG
else ifeq ($(MODE),asan)
  OPT := -O1 -g3 -fno-omit-frame-pointer
  SAN := -fsanitize=address,undefined
else
  $(error Unknown MODE '$(MODE)' (use debug, release or asan))
endif

BUILD  := build/$(MODE)
SRCS   := $(wildcard $(SRC_DIR)/*.c)
OBJS   := $(SRCS:$(SRC_DIR)/%.c=$(BUILD)/%.o)
DEPS   := $(OBJS:.o=.d)

CFLAGS  += -std=gnu11 -Wall -Wextra -Wpedantic -Wshadow $(OPT) $(SAN) -MMD -MP -I$(SRC_DIR)
LDFLAGS += $(SAN)

.PHONY: all run clean rebuild

all: $(TARGET)

$(TARGET): $(OBJS)
	$(CC) $(LDFLAGS) $^ -o $@

$(BUILD)/%.o: $(SRC_DIR)/%.c
	@mkdir -p $(@D)
	$(CC) $(CFLAGS) -c $< -o $@

# make run ARGS=hello.bin
run: $(TARGET)
	./$(TARGET) $(ARGS)

clean:
	rm -rf build $(TARGET)

rebuild: clean all

# header dependency files generated by -MMD
-include $(DEPS)